<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 白色背景 -->
    <solid android:color="@android:color/white"/>
    <!-- 圆角 -->
    <corners android:radius="8dp"/>
    <!-- 边框阴影（API 21+支持） -->
    <padding
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"/>
    <stroke
        android:width="1dp"
        android:color="@android:color/darker_gray"/>
</shape>
